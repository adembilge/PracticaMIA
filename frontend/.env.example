# Auth0 Regular Web Application (server-side only; no NEXT_PUBLIC_ secrets)
# Leave fields empty until an actual Auth0 application has been created.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
AUTH0_AUDIENCE=

# Optional local development base URL. Production should use an explicit stable URL.
APP_BASE_URL=http://localhost:3000

# Server-to-server FastAPI endpoint. Use HTTPS in production.
# Leave empty until the authenticated backend is privately deployed.
BACKEND_API_URL=
