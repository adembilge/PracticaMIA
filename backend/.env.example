# Local development only. Credentials here are NOT for production.
DATABASE_URL=postgresql+psycopg://practicamia:local_development_only@127.0.0.1:5432/practicamia

# Case API remains off until an actual trusted OIDC provider is configured.
ENABLE_DEMO_CASE_API=0
AUTH_ISSUER=https://YOUR-TRUSTED-ISSUER/
AUTH_AUDIENCE=YOUR-API-AUDIENCE
AUTH_JWKS_URL=https://YOUR-TRUSTED-ISSUER/.well-known/jwks.json

# P0 preparation preview, OFF by default. Never enable in production.
# Configure a separate staging branch already migrated to 20261106_0011.
# Fingerprint = SHA-256 of the exact DATABASE_URL bytes, not the URL itself.
ENABLE_PREPARATION_API=0
PREPARATION_TARGET=
PREPARATION_DATABASE_FINGERPRINT=
PREPARATION_DOCUMENT_KEY=
# Optional encrypted agent history on a separately migrated 0012 Preview branch.
# Disabled by default; NEVER enable in production or on staging schema 0011.
ENABLE_AGENT_HISTORY_API=0
# Public Ed25519 reviewer key only; private signing key must stay offline.
PREPARATION_RULE_REVIEW_PUBLIC_KEY=
